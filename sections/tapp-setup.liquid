<section class="tapp-setup" aria-labelledby="TappSetupHeading-{{ section.id }}">
  <div class="page-width tapp-setup__layout">
    <div class="tapp-setup__intro">
      <p class="tapp-setup__eyebrow">{{ 'sections.tapp_setup.eyebrow' | t }}</p>
      <h2 id="TappSetupHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p class="tapp-setup__lede">{{ section.settings.description | escape }}</p>
      <a class="tapp-setup__link" href="{{ section.settings.button_link | default: '/products/tapp-nfc-card' }}">{{ 'sections.tapp_setup.button' | t }} <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="tapp-setup__steps">
      <li class="tapp-setup__step tapp-setup__step--pink">
        <span class="tapp-setup__number">01</span>
        {% if section.settings.step_one_image != blank %}<img class="tapp-setup__image" src="{{ section.settings.step_one_image | escape }}" alt="{{ 'sections.tapp_setup.step_one_alt' | t | escape }}" width="720" height="517" loading="lazy">{% endif %}
        <div><h3>{{ 'sections.tapp_setup.step_one_title' | t }}</h3><p>{{ 'sections.tapp_setup.step_one_text' | t }}</p></div>
      </li>
      <li class="tapp-setup__step tapp-setup__step--yellow">
        <span class="tapp-setup__number">02</span>
        {% if section.settings.step_two_image != blank %}<img class="tapp-setup__image" src="{{ section.settings.step_two_image | escape }}" alt="{{ 'sections.tapp_setup.step_two_alt' | t | escape }}" width="720" height="665" loading="lazy">{% endif %}
        <div><h3>{{ 'sections.tapp_setup.step_two_title' | t }}</h3><p>{{ 'sections.tapp_setup.step_two_text' | t }}</p></div>
      </li>
      <li class="tapp-setup__step tapp-setup__step--ink tapp-setup__step--text">
        <span class="tapp-setup__number">03</span>
        <div><h3>{{ 'sections.tapp_setup.step_three_title' | t }}</h3><p>{{ 'sections.tapp_setup.step_three_text' | t }}</p></div>
      </li>
      <li class="tapp-setup__step tapp-setup__step--pink">
        <span class="tapp-setup__number">04</span>
        {% if section.settings.step_four_image != blank %}<img class="tapp-setup__image" src="{{ section.settings.step_four_image | escape }}" alt="{{ 'sections.tapp_setup.step_four_alt' | t | escape }}" width="720" height="837" loading="lazy">{% endif %}
        <div><h3>{{ 'sections.tapp_setup.step_four_title' | t }}</h3><p>{{ 'sections.tapp_setup.step_four_text' | t }}</p></div>
      </li>
    </ol>
  </div>
</section>

{% stylesheet %}
  .tapp-setup {
    overflow: hidden;
    padding: clamp(5rem, 8vw, 10rem) 0;
    color: #fff;
    background: #0b0a0d;
  }

  .tapp-setup__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 8rem);
  }

  .tapp-setup__eyebrow {
    display: inline-flex;
    margin: 0 0 1.5rem;
    color: #ff2990;
    font-size: 1.2rem;
    font-weight: 850;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .tapp-setup__intro h2 {
    max-width: 8ch;
    margin: 0;
    color: #fff;
    font-size: clamp(4.4rem, 7vw, 8.2rem);
    font-weight: 950;
    letter-spacing: -0.075em;
    line-height: 0.88;
    text-transform: uppercase;
  }

  .tapp-setup__lede {
    max-width: 44rem;
    margin: 2rem 0 2.7rem;
    color: rgba(255,255,255,0.82);
    font-size: clamp(1.6rem, 2vw, 2rem);
    line-height: 1.5;
  }

  .tapp-setup__link {
    display: inline-flex;
    min-height: 5.2rem;
    align-items: center;
    gap: 1rem;
    padding: 0 2.5rem;
    border-radius: 999px;
    color: #211722;
    background: #ff2990;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .tapp-setup__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tapp-setup__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
    min-height: 28rem;
    padding: 2rem;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 2rem;
    color: #fff;
    background: #0b0a0d;
  }

  .tapp-setup__step--pink, .tapp-setup__step--yellow, .tapp-setup__step--ink { color: #fff; background: #111014; }

  .tapp-setup__number { font-size: 1.2rem; font-weight: 900; letter-spacing: 0.1em; }

  .tapp-setup__image {
    display: block;
    width: 100%;
    height: 15rem;
    border: 0.3rem solid rgba(255,255,255,0.82);
    border-radius: 1.2rem;
    object-fit: contain;
    object-position: center;
    background: #09090a;
    box-shadow: 0 0.8rem 2rem rgba(33,23,34,0.22);
  }

  .tapp-setup__step--text::before { content: '↗'; display: grid; width: 100%; height: 15rem; place-items: center; border: 0.3rem solid rgba(255,255,255,0.12); border-radius: 1.2rem; color: #ff2990; background: #09090a; font-size: 6rem; font-weight: 300; }

  .tapp-setup__step h3 {
    margin: 0;
    font-size: clamp(1.8rem, 2.5vw, 2.6rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .tapp-setup__step p {
    max-width: 42rem;
    margin: 0.5rem 0 0;
    font-size: 1.5rem;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .tapp-setup__layout { grid-template-columns: 1fr; gap: 3rem; }
    .tapp-setup__intro h2 { max-width: 10ch; }
    .tapp-setup__steps { grid-template-columns: 1fr; }
    .tapp-setup__step { display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: start; gap: 0.8rem 1rem; min-height: auto; padding: 1.5rem; border-radius: 1.6rem; }
    .tapp-setup__step > .tapp-setup__number { grid-column: 1; grid-row: 1 / span 2; }
    .tapp-setup__image, .tapp-setup__step--text::before { grid-column: 2; width: 100%; height: 14rem; border-width: 0.2rem; border-radius: 0.8rem; }
    .tapp-setup__step > div { grid-column: 2; }
    .tapp-setup__step p { font-size: 1.35rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TAPP card setup",
  "tag": "section",
  "class": "section-tapp-setup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set it up. Tap it. Go." },
    { "type": "text", "id": "description", "label": "Description", "default": "Add your destination in NFC Tools, write it to your card, and you are ready to connect." },
    { "type": "url", "id": "step_one_image", "label": "Step 1 image" },
    { "type": "url", "id": "step_two_image", "label": "Step 2 image" },
    { "type": "url", "id": "step_four_image", "label": "Step 4 image" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "TAPP card setup" }]
}
{% endschema %}
