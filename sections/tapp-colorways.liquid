{%- assign tapp_product = section.settings.product -%}
<section class="tapp-colorways" aria-labelledby="TappColorwaysHeading-{{ section.id }}">
  <div class="tapp-colorways__inner">
    <h2 id="TappColorwaysHeading-{{ section.id }}" class="visually-hidden">{{ section.settings.heading | escape }}</h2>
    {% if tapp_product != blank %}
      <div class="tapp-colorways__grid">
        {% for variant in tapp_product.variants limit: 3 %}
          {% assign card_image = variant.featured_media.preview_image | default: tapp_product.featured_media.preview_image %}
          {% assign color_key = variant.title | downcase | handleize %}
          {% assign card_alt = variant.title | append: ' TAP NFC card' | escape %}
          {% case color_key %}
            {% when 'black' %}{% assign card_caption = 'A clean, classic look for your next introduction.' %}
            {% when 'pink' %}{% assign card_caption = 'A bright pop of color that stands out.' %}
            {% when 'transparent' %}{% assign card_caption = 'Clear finish with the NFC details on display.' %}
            {% else %}{% assign card_caption = 'A simple tap to make your next connection.' %}
          {% endcase %}
          <article class="tapp-color-card tapp-color-card--{{ color_key }}">
            <a class="tapp-color-card__image-link" href="{{ tapp_product.url }}?variant={{ variant.id }}" aria-label="{{ 'sections.tapp_colorways.shop_colorway' | t: color: variant.title | escape }}">
              {% if card_image != blank %}
                {{ card_image | image_url: width: 900 | image_tag: class: 'tapp-color-card__image', alt: card_alt, loading: 'lazy' }}
              {% endif %}
            </a>
            <div class="tapp-color-card__details">
              <h3><a href="{{ tapp_product.url }}?variant={{ variant.id }}">{{ variant.title | escape }}</a></h3>
              <span class="tapp-color-card__price">{{ variant.price | money }}</span>
              <p>{{ card_caption }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="tapp-colorways__empty">{{ 'sections.tapp_colorways.choose_product' | t }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .tapp-colorways {
    padding: 0;
    background: #f2f2f2;
    color: #171717;
  }

  .tapp-colorways__inner {
    width: 100%;
  }

  .tapp-colorways__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: #fff;
  }

  .tapp-color-card {
    min-width: 0;
    padding: 0;
    background: #f2f2f2;
  }

  .tapp-color-card__image-link {
    position: relative;
    display: block;
    overflow: hidden;
    background: #f2f2f2;
    aspect-ratio: 1 / 0.94;
  }

  .tapp-color-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 220ms ease;
  }

  .tapp-color-card__image-link:hover .tapp-color-card__image { transform: scale(1.025); }

  .tapp-color-card__details {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 1.8rem 2rem 2.2rem;
  }

  .tapp-color-card__details h3 {
    margin: 0;
    font-size: clamp(1.4rem, 1.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .tapp-color-card__details h3 a { color: inherit; text-decoration: none; }
  .tapp-color-card__details h3 a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  .tapp-color-card__details p {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
    color: #242424;
    font-size: clamp(1.2rem, 1.25vw, 1.55rem);
    line-height: 1.35;
  }

  .tapp-color-card__price {
    flex: 0 0 auto;
    font-size: clamp(1.2rem, 1.3vw, 1.7rem);
    white-space: nowrap;
  }

  .tapp-colorways__empty { text-align: center; }

  @media screen and (max-width: 749px) {
    .tapp-color-card__image-link { aspect-ratio: 1 / 1; }
    .tapp-color-card__details { padding: 1rem 0.8rem 1.4rem; column-gap: 0.4rem; }
    .tapp-color-card__details h3 { font-size: clamp(1rem, 3vw, 1.5rem); }
    .tapp-color-card__details p { font-size: 1rem; }
    .tapp-color-card__price { font-size: clamp(0.95rem, 2.7vw, 1.2rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tapp-color-card__image { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TAP colorways",
  "tag": "section",
  "class": "section-tapp-colorways",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your color. Make it yours." },
    { "type": "text", "id": "description", "label": "Description", "default": "Three card finishes. One tap away from your next connection." }
  ],
  "presets": [{ "name": "TAP colorways" }]
}
{% endschema %}
